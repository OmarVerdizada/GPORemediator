<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" /><PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.31" /></ItemGroup>
  <ItemGroup>
    <Content Include="PowerShell\Invoke-GpoWorkflow.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="PowerShell\GpoWorkflow.Worker.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="PowerShell\SecurityTemplate.psm1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="data\benchmark.json" LogicalName="GpoRemediator.Data.benchmark.json" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="data/gpo-production-mappings.json" />
  </ItemGroup>
</Project>
